        gripper.move_gripper(width_m=0.5, force_limit_nm=2.0, feedforward_torque_nm=1.0)
        
        for _ in range(50):
            time.sleep(0.1)
            width, _, force, _, _, _ = gripper.get_current_gripper_states()
